{
  "manifest_version": 2,
  "name": "Hayatab",
  "version": "1.0.1",
  "description": "AI-powered tab grouping",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": ["background/background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Hayatab",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com http://localhost:*;",
  "browser_specific_settings": {
    "gecko": {
      "id": "hayatab@hayase.moe",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"],
        "optional": []
      }
    }
  }
}
